{
  "name": "Tabfold",
  "description": "Save tabs, free memory, restore when you need them. Local-only.",
  "version": "1.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "action": {
    "default_title": "Save current tab with Tabfold",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "tabs", "contextMenus", "favicon"],
  "host_permissions": [],
  "commands": {
    "save-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Save current tab"
    },
    "open-library": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Open Tabfold library"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: chrome:; connect-src 'none'; style-src 'self' 'unsafe-inline';"
  }
}
