{
  "name": "tabfold",
  "version": "1.0.0",
  "private": true,
  "description": "Save tabs, free memory, restore when needed — local-only Chrome extension.",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons": "tsx scripts/generate-icons.ts",
    "pack": "npm run build && tsx scripts/pack.ts",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.18.6",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
